{
  "name": "bazak",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @bazak/web dev",
    "build": "pnpm -r --if-present run build",
    "start": "pnpm --filter @bazak/web start",
    "typecheck": "pnpm -r --if-present run typecheck",
    "prepare": "lefthook install",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "doctor": "react-doctor --yes --scope full --blocking warning --no-telemetry --no-supply-chain",
    "ui:check": "node node_modules/hallmark-ui/skills/hallmark/scripts/sloplint.mjs apps/web packages --scope app",
    "db:up": "docker compose up --detach --wait",
    "db:down": "docker compose down",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm run doctor && pnpm ui:check && docker compose config --quiet && pnpm -r --if-present run test && pnpm build"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "hallmark-ui": "https://codeload.github.com/Nutlope/hallmark/tar.gz/04977e15f3dfd6ee4b74c887dac3eb52665d6c92",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.90.0",
    "react-doctor": "0.9.23"
  },
  "packageManager": "pnpm@12.16.1"
}

{
  "name": "bazak",
  "private": true,
  "type": "module",
  "scripts": {
    "worker": "pnpm --filter @bazak/worker start",
    "dev": "pnpm --filter @bazak/web dev",
    "build": "moon run :build",
    "start": "pnpm --filter @bazak/web start",
    "typecheck": "moon run :typecheck",
    "prepare": "lefthook install",
    "lint": "oxlint --deny-warnings . && node --test tools/oxlint/require-named-effect.test.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "doctor": "react-doctor --yes --scope full --blocking warning --no-telemetry --no-supply-chain",
    "ui:check": "node node_modules/hallmark-ui/skills/hallmark/scripts/sloplint.mjs apps packages --scope app",
    "db:up": "docker compose up --detach --wait && pnpm db:migrate",
    "db:down": "docker compose down",
    "check": "pnpm api:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm run doctor && pnpm ui:check && docker compose config --quiet && moon run :test :build && pnpm test:journey",
    "dev:management": "pnpm --filter @bazak/management dev",
    "start:management": "pnpm --filter @bazak/management start",
    "db:migrate": "pnpm --filter @bazak/evaluation-store exec prisma migrate deploy",
    "eval:import": "tsx packages/adapters/evaluation-store/src/import.ts",
    "db:migrate:dev": "pnpm --filter @bazak/evaluation-store exec prisma migrate dev",
    "db:generate": "pnpm --filter @bazak/evaluation-store exec prisma generate",
    "db:studio": "pnpm --filter @bazak/evaluation-store exec prisma studio",
    "evaluate": "tsx scripts/evaluate.ts",
    "evaluate:model": "tsx scripts/evaluate-model.ts",
    "evaluate:harness": "tsx scripts/evaluate-harness.ts",
    "evaluate:live": "tsx scripts/evaluate-live.ts",
    "evaluate:import": "tsx packages/adapters/evaluation-store/src/import.ts",
    "test": "moon run :test",
    "test:integration": "tsx scripts/test-database.ts integration",
    "test:e2e": "tsx scripts/test-database.ts browser",
    "build:fixture": "pnpm --filter @bazak/web build:fixture",
    "start:fixture": "pnpm --filter @bazak/web start:fixture",
    "test:journey": "tsx scripts/test-database.ts all",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@playwright/test": "1.65.1",
    "hallmark-ui": "https://codeload.github.com/Nutlope/hallmark/tar.gz/04977e15f3dfd6ee4b74c887dac3eb52665d6c92",
    "lefthook": "2.2.2",
    "orval": "8.48.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.90.0",
    "react-doctor": "0.9.23",
    "tsx": "4.23.15"
  },
  "packageManager": "pnpm@12.16.1"
}
